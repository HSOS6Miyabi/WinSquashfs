#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ARCHIVEFS_VERSION_RC@,0
 PRODUCTVERSION @ARCHIVEFS_VERSION_RC@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "@ARCHIVEFS_DESCRIPTION@"
   VALUE "FileVersion", "@ARCHIVEFS_VERSION@.0"
   VALUE "ProductName", "WinArchiveFSPro"
   VALUE "ProductVersion", "@ARCHIVEFS_VERSION@.0"
   VALUE "OriginalFilename", "@ARCHIVEFS_FILENAME@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
