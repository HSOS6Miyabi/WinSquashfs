[Version]
Signature="$Windows NT$"
Class=ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider=%Provider%
DriverVer=@DATE@,@VERSION@
CatalogFile=ArchiveFsUncFilter.cat
PnpLockdown=1

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
ArchiveFsUncFilter.sys=1

[DestinationDirs]
Modern.Files=13
Legacy.Files=12

[DefaultInstall.NT@ARCH@.10.0...25952]
CopyFiles=Modern.Files

[DefaultInstall.NT@ARCH@.10.0...25952.Services]
AddService=ArchiveFsUncFilter,,Modern.Service

[DefaultInstall.NT@ARCH@]
CopyFiles=Legacy.Files

[DefaultInstall.NT@ARCH@.Services]
AddService=ArchiveFsUncFilter,,Legacy.Service

[DefaultUninstall.NT@ARCH@]
LegacyUninstall=1
DelFiles=Legacy.Files

[DefaultUninstall.NT@ARCH@.Services]
DelService=ArchiveFsUncFilter,0x204

[Modern.Files]
ArchiveFsUncFilter.sys

[Legacy.Files]
ArchiveFsUncFilter.sys

[Modern.Service]
DisplayName=%Description%
Description=%Description%
ServiceBinary=%13%\ArchiveFsUncFilter.sys
Dependencies=FltMgr
ServiceType=2
StartType=3
ErrorControl=1
LoadOrderGroup="FSFilter Activity Monitor"
AddReg=Modern.Registry,Common.Registry

[Legacy.Service]
DisplayName=%Description%
Description=%Description%
ServiceBinary=%12%\ArchiveFsUncFilter.sys
Dependencies=FltMgr
ServiceType=2
StartType=3
ErrorControl=1
LoadOrderGroup="FSFilter Activity Monitor"
AddReg=Legacy.Registry,Common.Registry

[Modern.Registry]
HKR,"Parameters\Instances","DefaultInstance",0x0,"ArchiveFsUncFilter"
HKR,"Parameters\Instances\ArchiveFsUncFilter","Altitude",0x0,"@ALTITUDE@"
HKR,"Parameters\Instances\ArchiveFsUncFilter","Flags",0x00010001,0

[Legacy.Registry]
HKR,"Instances","DefaultInstance",0x0,"ArchiveFsUncFilter"
HKR,"Instances\ArchiveFsUncFilter","Altitude",0x0,"@ALTITUDE@"
HKR,"Instances\ArchiveFsUncFilter","Flags",0x00010001,0

[Common.Registry]
HKR,"Parameters","IncludeUnqualified",0x00010001,@UNQUALIFIED@

[Strings]
Provider="WinArchiveFSPro"
Description="WinArchiveFSPro UNC alias filter"
Disk="WinArchiveFSPro UNC alias filter installation media"
